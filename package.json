{
  "name": "delenda-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:ssh-gateway": "mkdir -p .tmp/ssh-gateway && esbuild packages/ssh-gateway/src/authorized-keys.ts --bundle --platform=node --format=esm --target=node22 --outfile=.tmp/ssh-gateway/authorized-keys.mjs && esbuild packages/ssh-gateway/src/session.ts --bundle --platform=node --format=esm --target=node22 --outfile=.tmp/ssh-gateway/session.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "cloudflare:types": "bash scripts/cloudflare-env.sh -- npx wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-file cloudflare/.dev.vars.example --strict-vars=false --include-runtime=false",
    "cloudflare:types:check": "bash scripts/cloudflare-env.sh -- npx wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-file cloudflare/.dev.vars.example --strict-vars=false --include-runtime=false --check",
    "cloudflare:dry-run": "bash scripts/cloudflare-dry-run.sh",
    "cloudflare:validate": "npm run typecheck && npm run build && npm run cloudflare:types:check && npm run cloudflare:dry-run",
    "simulate:balance": "bash scripts/simulate-campaign-balance.sh",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/cloudflare-plumbing.test.mjs && bash scripts/test-rules.sh && bash scripts/test-ava.sh && bash scripts/test-substrate.sh",
    "test:substrate": "bash scripts/test-substrate.sh",
    "test:live": "node --test tests/live-entry.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .tmp --ignore-pattern .wrangler",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "DELENDA.QUEST"
}
