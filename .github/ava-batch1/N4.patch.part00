diff --git a/app/ava/contextual-language-projection.ts b/app/ava/contextual-language-projection.ts
new file mode 100644
index 0000000..d106f7d
--- /dev/null
+++ b/app/ava/contextual-language-projection.ts
@@ -0,0 +1,80 @@
+import { operationalObjectiveForProblemClass } from "../campaign-substrate";
+import type { GameState } from "../game";
+import { cognitiveDigest } from "./cognitive-types";
+import { AVA_STATIC_LANGUAGE_CATALOG } from "./contextual-language-catalog";
+import {
+  AVA_CONTEXTUAL_LANGUAGE_VERSION,
+  stableLanguageDigest,
+  validateContextualLanguage,
+  type AvaContextualLanguage,
+  type AvaLanguageEntry,
+} from "./contextual-language";
+import { avaRequestStateSeal } from "./request-ir";
+import type { AvaEntity } from "./schema";
+
+const objectiveSurfaces = Object.freeze([
+  "goal",
+  "goals",
+  "objective",
+  "objectives",
+  "operational objective",
+  "command objective",
+  "what is the goal",
+  "what are our goals",
+]);
+
+export const buildAvaContextualLanguage = (
+  state: GameState,
+  entities: readonly AvaEntity[],
+): AvaContextualLanguage => {
+  const situation =
+    state.currentSituation?.day === state.day ? state.currentSituation : null;
+  const objective = situation
+    ? operationalObjectiveForProblemClass(situation.problemClass)
+    : null;
+  const hasObjectiveEntity = entities.some(
+    (entity) => entity.id === "campaign-objective" && !entity.action,
+  );
+  const dynamicEntries: AvaLanguageEntry[] = [];
+
+  if (situation && objective && hasObjectiveEntity)
+    dynamicEntries.push({
+      id: "objective.current",
+      label: objective,
+      surfaces: objectiveSurfaces,
+      route: "OBJECTIVE_EXPLANATION",
+      entityId: "campaign-objective",
+      facet: "meaning",
+      source: "CURRENT_SITUATION",
+      provenance: [
+        "currentSituation.problemClass",
+        "operationalObjectiveForProblemClass",
+      ],
+    });
+
+  const entries = [...AVA_STATIC_LANGUAGE_CATALOG, ...dynamicEntries];
+  const stateRevision = avaRequestStateSeal(state);
+  const contentRevision = cognitiveDigest({
+    contentPackVersion: state.contentPackVersion,
+    day: situation?.day ?? null,
+    blueprintId: situation?.blueprintId ?? null,
+    problemClass: situation?.problemClass ?? null,
+    sector: situation?.sector ?? null,
+    objective,
+  });
+  const digest = stableLanguageDigest({
+    version: AVA_CONTEXTUAL_LANGUAGE_VERSION,
+    stateRevision,
+    contentRevision,
+    entries,
+  });
+  const language: AvaContextualLanguage = {
+    version: AVA_CONTEXTUAL_LANGUAGE_VERSION,
+    stateRevision,
+    contentRevision,
+    entries,
+    digest,
+  };
+  validateContextualLanguage(language);
+  return language;
+};
diff --git a/app/ava/game-context.ts b/app/ava/game-context.ts
index 036fbb2..1565344 100644
--- a/app/ava/game-context.ts
+++ b/app/ava/game-context.ts
