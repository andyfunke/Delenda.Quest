 import { GameState, situationForState } from "../game";
+import { operationalObjectiveForProblemClass } from "../campaign-substrate";
 import { compileConvergence } from "../convergence";
 import type { AvaEntity } from "./schema";
 import { enumerateAvaActions } from "./runtime";
@@ -153,6 +154,26 @@ export const avaEntitiesForState = (
       aliases: [situation.sector, situation.problemClass],
       parentId: "main",
     },
+    ...(state.currentSituation?.day === state.day
+      ? [
+          {
+            id: "campaign-objective",
+            kind: "mission" as const,
+            label: operationalObjectiveForProblemClass(
+              state.currentSituation.problemClass,
+            ),
+            aliases: [
+              "goal",
+              "goals",
+              "objective",
+              "objectives",
+              "operational objective",
+              "command objective",
+            ],
+            parentId: "main",
+          },
+        ]
+      : []),
     ...actionEntities,
   ];
 };
