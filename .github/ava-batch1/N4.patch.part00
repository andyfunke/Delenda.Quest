 CONTEXTUAL_LANGUAGE_BUNDLE="$(mktemp "${TEMP_ROOT}/delenda-ava-contextual-language.XXXXXX.mjs")"
 CONTEXTUAL_CATALOG_BUNDLE="$(mktemp "${TEMP_ROOT}/delenda-ava-contextual-catalog.XXXXXX.mjs")"
