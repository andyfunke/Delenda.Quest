 node_modules/.bin/esbuild app/ava/contextual-language-catalog.ts --bundle --platform=node --format=esm --outfile="$CONTEXTUAL_CATALOG_BUNDLE" >/dev/null
 node_modules/.bin/esbuild packages/priorities-library/src/index.ts --bundle --platform=node --format=esm --outfile="$PRIORITIES_BUNDLE" >/dev/null
+node_modules/.bin/esbuild app/ava