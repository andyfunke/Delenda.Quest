diff --git a/tests/ava-contextual-language-contracts.test.mjs b/tests/ava-contextual-language-contracts.test.mjs
new file mode 100644
index 0000000..35b9c00
--- /dev/null
+++ b/tests/ava-contextual-language-contracts.test.mjs
@@ -0,0 +1,73 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const languageModule = await import(
+  process.env.DELENDA_AVA_CONTEXTUAL_LANGUAGE_BUNDLE
+);
+
+const {
+  AVA_CONTEXTUAL_LANGUAGE_VERSION,
+  validateContextualLanguage,
+  validateLanguageEntries,
+} = languageModule;
+
+const entry = (overrides = {}) => ({
+  id: "metric.front",
+  label: "Front",
+  surfaces: ["front"],
+  route: "METRIC_EXPLANATION",
+  entityId: "front",
+  facet: "meaning",
+  source: "STATIC_CATALOG",
+  provenance: ["test"],
+  ...overrides,
+});
+
+const projection = (overrides = {}) => ({
+  version: AVA_CONTEXTUAL_LANGUAGE_VERSION,
+  stateRevision: "state-1",
+  contentRevision: "content-1",
+  entries: [entry()],
+  digest: "digest-1",
+  ...overrides,
+});
+
+test("contextual language contract accepts valid entries and projections", () => {
+  assert.doesNotThrow(() => validateLanguageEntries([entry()]));
+  assert.doesNotThrow(() => validateContextualLanguage(projection()));
+});
+
+test("contextual language contract rejects malformed entries", () => {
+  assert.throws(() => validateLanguageEntries([entry({ id: "" })]), /id/i);
+  assert.throws(() => validateLanguageEntries([entry({ label: "" })]), /label/i);
+  assert.throws(() => validateLanguageEntries([entry({ surfaces: [] })]), /surface/i);
+  assert.throws(() => validateLanguageEntries([entry({ route: "NOPE" })]), /route/i);
+  assert.throws(() => validateLanguageEntries([entry({ source: "NOPE" })]), /source/i);
+  assert.throws(
+    () =>
+      validateLanguageEntries([
+        entry({ route: "PRIORITY_FOCUS", entityId: undefined }),
+      ]),
+    /axes/i,
+  );
+  assert.throws(
+    () => validateLanguageEntries([entry({ route: "REPORT", reportTopic: undefined })]),
+    /reportTopic/i,
+  );
+  assert.throws(
+    () => validateLanguageEntries([entry({ entityId: undefined })]),
+    /entityId/i,
+  );
+  assert.throws(
+    () =>
+      validateLanguageEntries([
+        entry({ route: "NARRATIVE_REFERENCE", entityId: undefined }),
+      ]),
+    /evidence/i,
+  );
+});
+
+test("contextual language contract rejects missing revisions", () => {
+  assert.throws(() => validateContextualLanguage(projection({ stateRevision: "" })), /stateRevision/);
+  assert.throws(() => validateContextualLanguage(projection({ contentRevision: "" })), /contentRevision/);
+});
