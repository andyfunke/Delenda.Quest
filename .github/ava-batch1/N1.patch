+type PriorityAxis = import("../../packages/priorities-library/src/schema").PriorityAxis;
+type AvaReportTopic = import("./schema").AvaReportTopic;
+
+export const AVA_CONTEXTUAL_LANGUAGE_VERSION =
+  "ava-contextual-language/v1" as const;
+
+export const AVA_LANGUAGE_ROUTES = [
+  "PRIORITY_FOCUS",
+  "STRATEGIC_ADVICE",
+  "METRIC_EXPLANATION",
+  "REPORT",
+  "OBJECTIVE_EXPLANATION",
+  "NARRATIVE_REFERENCE",
+] as const;
+
+export const AVA_LANGUAGE_SOURCES = [
+  "STATIC_CATALOG",
+  "CURRENT_SITUATION",
+  "CURRENT_METRIC",
+  "CURRENT_ACTION",
+  "AUTHORED_BRIEF",
+] as const;
+
+export type AvaLanguageRoute = (typeof AVA_LANGUAGE_ROUTES)[number];
+export type AvaLanguageSource = (typeof AVA_LANGUAGE_SOURCES)[number];
+export type AvaLanguageFacet = "meaning" | "effects" | "levers" | "calculus";
+export type AvaNarrativeSection =
+  | "headline"
+  | "briefing"
+  | "question"
+  | "standing-order"
+  | "maneuver-label"
+  | "maneuver-rationale";
+
+export type AvaLanguageEvidence = {
+  section: AvaNarrativeSection;
+  excerpt: string;
+};
+
+export type AvaLanguageEntry = {
+  id: string;
+  label: string;
+  surfaces: readonly string[];
+  route: AvaLanguageRoute;
+  entityId?: string;
+  reportTopic?: AvaReportTopic;
+  facet?: AvaLanguageFacet;
+  priorityAxes?: readonly PriorityAxis[];
+  source: AvaLanguageSource;
+  provenance: readonly string[];
+  evidence?: readonly AvaLanguageEvidence[];
+};
+
+export type AvaContextualLanguage = {
+  version: typeof AVA_CONTEXTUAL_LANGUAGE_VERSION;
+  stateRevision: string;
+  contentRevision: string;
+  entries: readonly AvaLanguageEntry[];
+  digest: string;
+};
+
+const nonEmpty = (value: unknown): value is string =>
+  typeof value === "string" && value.trim().length > 0;
+
+const routeSet = new Set<string>(AVA_LANGUAGE_ROUTES);
+const sourceSet = new Set<string>(AVA_LANGUAGE_SOURCES);
+
+export const validateLanguageEntries = (
+  entries: readonly AvaLanguageEntry[],
+): void => {
+  if (!Array.isArray(entries))
+    throw new Error("contextual language entries must be an array");
+  for (const entry of entries) {
+    if (!nonEmpty(entry.id)) throw new Error("contextual language entry id is required");
+    if (!nonEmpty(entry.label))
+      throw new Error(`${entry.id}: contextual language label is required`);
+    if (!Array.isArray(entry.surfaces) || entry.surfaces.length === 0)
+      throw new Error(`${entry.id}: at least one contextual surface is required`);
+    if (entry.surfaces.some((surface) => !nonEmpty(surface)))
+      throw new Error(`${entry.id}: contextual surfaces must be non-empty`);
+    if (!routeSet.has(entry.route))
+      throw new Error(`${entry.id}: invalid contextual language route ${String(entry.route)}`);
+    if (!sourceSet.has(entry.source))
+      throw new Error(`${entry.id}: invalid contextual language source ${String(entry.source)}`);
+    if (!Array.isArray(entry.provenance) || entry.provenance.length === 0)
+      throw new Error(`${entry.id}: contextual language provenance is required`);
+    if (entry.provenance.some((value) => !nonEmpty(value)))
+      throw new Error(`${entry.id}: contextual language provenance must be non-empty`);
+
+    if (
+      entry.route === "PRIORITY_FOCUS" &&
+      (!entry.priorityAxes ||
+        entry.priorityAxes.length === 0 ||
+        entry.priorityAxes.length > 4)
+    )
+      throw new Error(`${entry.id}: PRIORITY_FOCUS requires one to four axes`);
+    if (entry.route === "REPORT" && !nonEmpty(entry.reportTopic))
+      throw new Error(`${entry.id}: REPORT requires reportTopic`);
+    if (
+      (entry.route === "METRIC_EXPLANATION" ||
+        entry.route === "OBJECTIVE_EXPLANATION") &&
+      !nonEmpty(entry.entityId)
+    )
+      throw new Error(`${entry.id}: ${entry.route} requires entityId`);
+    if (
+      entry.route === "NARRATIVE_REFERENCE" &&
+      (!entry.evidence || entry.evidence.length === 0)
+    )
+      throw new Error(`${entry.id}: NARRATIVE_REFERENCE requires evidence`);
+  }
+};
+
+export const validateContextualLanguage = (
+  language: AvaContextualLanguage,
+): void => {
+  if (!language || typeof language !== "object")
+    throw new Error("contextual language projection is required");
+  if (language.version !== AVA_CONTEXTUAL_LANGUAGE_VERSION)
+    throw new Error(`invalid contextual language version ${String(language.version)}`);
+  if (!nonEmpty(language.stateRevision))
+    throw new Error(K
"contextual language stateRevision is required");
+  if (!nonEmpty(language.contentRevision))
+    throw new Error("contextual language contentRevision is required");
+  if (!nonEmpty(language.digest))
+    throw new Error(K
"contextual language digest is required");
+  validateLanguageEntries(language.entries);
+};
