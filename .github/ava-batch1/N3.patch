diff --git a/tests/priorities-contextual-intent.test.mjs b/tests/priorities-contextual-intent.test.mjs
new file mode 100644
index 0000000..ee906e8
--- /dev/null
+++ b/tests/priorities-contextual-intent.test.mjs
@@ -0,0 +1,57 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const priorities = await import(process.env.DELENDA_PRIORITIES_BUNDLE);
+const {
+  PRIORITY_AXIS_CATALOG,
+  PRIORITY_SCHEMA_VERSION,
+  compileDeclaredPriorityFocus,
+} = priorities;
+
+test("declared territory focus uses the authoritative priority schema", () => {
+  const intent = compileDeclaredPriorityFocus(["territory"], "gain territory");
+  assert.equal(intent.schemaVersion, PRIORITY_SCHEMA_VERSION);
+  assert.deepEqual(intent.axes, ["territory"]);
+  assert.deepEqual(intent.orderedAxes, ["territory"]);
+  assert.equal(intent.chord.id, "territory");
+  assert.deepEqual(intent.signals, [{ axis: "territory", surface: "territory" }]);
+});
+
+test("declared advance focus preserves a declared axis without lexical fabrication", () => {
+  const intent = compileDeclaredPriorityFocus(
+    ["attack", "territory"],
+    "advance",
+  );
+  assert.deepEqual(intent.axes, ["attack", "territory"]);
+  assert.deepEqual(intent.orderedAxes, ["attack", "territory"]);
+  assert.equal(intent.chord.id, "attack>territory");
+  assert.deepEqual(intent.signals, [{ axis: "attack", surface: "advance" }]);
+});
+
+test("declared priority focus rejects invalid declarations", () => {
+  assert.throws(() => compileDeclaredPriorityFocus([], "advance"), /at least one/i);
+  assert.throws(
+    () => compileDeclaredPriorityFocus(["territory", "territory"], "advance"),
+    /unique/i,
+  );
+  assert.throws(
+    () => compileDeclaredPriorityFocus(["unknown"], "advance"),
+    /invalid priority axis/i,
+  );
+  assert.throws(
+    () =>
+      compileDeclaredPriorityFocus(
+        ["attack", "territory", "attack", "territory", "attack"],
+        "advance",
+      ),
+    /at most four/i,
+  );
+});
+
+test("declared priority focus is deterministic and does not mutate the catalog", () => {
+  const before = JSON.stringify(PRIORITY_AXIS_CATALOG);
+  const first = compileDeclaredPriorityFocus(["attack", "territory"], "advance");
+  const second = compileDeclaredPriorityFocus(["territory", "attack"], "advance");
+  assert.deepEqual(first, second);
+  assert.equal(JSON.stringify(PRIORITY_AXIS_CATALOG), before);
+});
