+import type { PriorityAxis, PriorityChord } from "../schema";
+
+export type PriorityAxisDefinition = {
+  id: PriorityAxis;
+  signals: readonly string[];
+};
+
+export const PRIORITY_AXIS_CATALOG: readonly PriorityAxisDefinition[] =
+  Object.freeze([
+    Object.freeze({
+      id: "attack",
+      signals: Object.freeze([
+        "attack",
+        "advance",
+        "advancing",
+        "break through",
+        "breakthrough",
+        "offense",
+        "offensive",
+      ]),
+    }),
+    Object.freeze({
+      id: "territory",
+      signals: Object.freeze([
+        "territory",
+        "ground",
+        "front",
+        "front line",
+        "territorial",
+      ]),
+    }),
+  ]);
+
+export const PRIORITY_CHORDS: readonly PriorityChord[] = Object.freeze([
+  Object.freeze({ id: "attack", axes: Object.freeze(["attack"]) }),
+  Object.freeze({
+    id: "attack>territory",
+    axes: Object.freeze(["attack", "territory"]),
+  }),
+  Object.freeze({ id: "territory", axes: Object.freeze(["territory"]) }),
+]);
diff --git a/packages/priorities-library/src/compiler.ts b/packages/priorities-library/src/compiler.ts
new file mode 100644
index 0000000..ac84187
--- /dev/null
+++ b/packages/priorities-library/src/compiler.ts
@@ -0,0 +1,71 @@
+import { PRIORITY_AXIS_CATALOG, PRIORITY_CHORDS } from "./catalog/index";
+import {
+  PRIORITY_SCHEMA_VERSION,
+  type CompiledPriorityIntent,
+  type PriorityAxis,
+  type PrioritySignal,
+} from "./schema";
+
+export const normalizePriorityInput = (raw: string): string =>
+  raw
+    .normalize("NFKC")
+    .toLowerCase()
+    .replace(/[’‘]/g, "'")
+    .replace(/[^\p{L}\p{N}']+/gu, " ")
+    .trim()
+    .replace(/\s+/g, " ");
+
+const catalogAxes = new Set<PriorityAxis>(
+  PRIORITY_AXIS_CATALOG.map((definition) => definition.id),
+);
+
+const matchedSignals = (normalizedInput: string): PrioritySignal[] => {
+  const padded = ` ${normalizedInput} `;
+  return PRIORITY_AXIS_CATALOG.flatMap((definition) =>
+    definition.signals
+      .filter((surface) => padded.includes(` ${normalizePriorityInput(surface)} `))
+      .map((surface) => ({ axis: definition.id, surface })),
+  );
+};
+
+export const compileDeclaredPriorityFocus = (
+  axes: readonly PriorityAxis[],
+  surface: string,
+): CompiledPriorityIntent => {
+  const normalizedInput = normalizePriorityInput(surface);
+  if (!normalizedInput)
+    throw new Error("declared priority focus requires a non-empty surface");
+  if (!axes.length)
+    throw new Error("declared priority focus requires at least one axis");
+  if (axes.length > 4)
+    throw new Error("declared priority focus supports at most four axes");
+  if (new Set(axes).size !== axes.length)
+    throw new Error("declared priority focus axes must be unique");
+  for (const axis of axes)
+    if (!catalogAxes.has(axis)) throw new Error(`invalid priority axis ${axis}`);
+
+  const requestedAxes = new Set(axes);
+  const orderedAxes = PRIORITY_AXIS_CATALOG.map((definition) => definition.id).filter(
+    (axis) => requestedAxes.has(axis),
+  );
+  const signals = matchedSignals(normalizedInput).filter((signal) =>
+    requestedAxes.has(signal.axis),
+  );
+  const chordId = orderedAxes.join(">");
+  const chord = PRIORITY_CHORDS.find((candidate) => candidate.id === chordId) ?? null;
+  if (!chord)
+    throw new Error(`no declared priority chord owns ${chordId}`);
+
+  return {
+    schemaVersion: PRIORITY_SCHEMA_VERSION,
+    normalizedInput,
+    requested: true,
+    axes: [...orderedAxes],
+    orderedAxes: [...orderedAxes],
+    signals,
+    chord,
+    ignoredNegation: normalizedInput
+      .split(" ")
+      .some((token) => ["no", "not", "never", "dont", "don't"].includes(token)),
+  };
+};
