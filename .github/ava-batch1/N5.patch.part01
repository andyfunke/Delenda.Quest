+const { compileAvaContextualLanguage } = await import(compilerBundle);
+const { initialState } = await import(gameBundle);
+const { avaEntitiesForState } = await import(contextBundle);
+
+const state = initialState({ seed: 1729 });
+const entities = avaEntitiesForState(state);
+const context = {
+  currentModule: "campaign",
+  entities,
+  language: buildAvaContextualLanguage(state, entities),
+};
+
