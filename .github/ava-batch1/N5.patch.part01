nguageSurface(surface) === normalized,
+    ),
+  );
+  if (candidates.length === 0) return null;
+
+  const destinations = new Map<string, AvaLanguageEntry[]>();
+  for (const candidate of candidates) {
+    const signature = destinationSignature(candidate);
+    destinations.set(signature, [
+      ...(destinations.get(signature) ?? []),
+      candidate,
+    ]);
+  }
+  const deterministic = [...candidates].sort(
+    (left, right) =>
+      sourcePriority[left.source] - sourcePriority[right.source] ||
+      left.id.localeCompare(right.id),
+  );
+  const representative = deterministic[0]!;
+  if (destinations.size > 1)
+    return clarify(
+      raw,
+      normalized,
+      representative,
+      context,
+      `The phrase ${JSON.stringify(raw.trim())} has multiple incompatible contextual owners.`,
+    );
+
+  return lowerContextualEntry(raw, normalized, representative, context);
+};
