+const gameBundle = process.env.DELENDA_AVA_GAME_BUNDLE;
+const contextBundle = process.env.DELENDA_AVA_CONTEXT_BUNDLE;
+if (!projectionBundle || !compilerBundle || !gameBundle || !contextBundle)
+  throw new Error("contextual compiler test bundles are required");
+
