+import test from "node:test";
+import assert from "node:assert/strict";
+
+const language = await import(process.env.DELENDA_AVA_CONTEXTUAL_LANGUAGE_BUNDLE);
+const catalogModule = await import(process.env.DELENDA_AVA_CONTEXTUAL_CATALOG_BUNDLE);
+
+const {
+  normalizeAvaLanguageSurface,
+  stableLanguageDigest,
+  validateLanguageEntries,
+} = language;
+const { AVA_STATIC_LANGUAGE_CATALOG } = catalogModule;
+
+const expected = new Map([
+  ["gain territory", "priority.territory"],
+  ["gain ground", "priority.territory"],
+  ["take ground", "priority.territory"],
+  ["secure territory", "priority.territory"],
+  ["move the front", "priority.territory"],
+  ["push the front", "priority.territory"],
+  ["advance", "priority.advance"],
+  ["advancing", "priority.advance"],
+  ["break through", "priority.advance"],
+  ["breakthrough", "priority.advance"],
+  ["front", "metric.front-movement"],
+  ["front line", "metric.front-movement"],
+  ["frontline", "metric.front-movement"],
+  ["ground movement", "metric.front-movement"],
+  ["ground gained", "metric.front-movement"],
+  ["kilometer", "metric.front-movement"],
+  ["kilometers", "metric.front-movement"],
+  ["km", "metric.front-movement"],
+  ["distance gained", "metric.front-movement"],
+  ["how far did we move", "metric.front-movement"],
+  ["supply", "metric.supply"],
+  ["communications", "metric.communications"],
+  ["intelligence", "metric.intelligence"],
+  ["readiness", "metric.readiness"],
+  ["force", "metric.force"],
+  ["position", "metric.position"],
+  ["pressure", "metric.pressure"],
+  ["enemy position", "report.adversary"],
+  ["enemy positions", "report.adversary"],
+  ["enemy line", "report.adversary"],
+  ["enemy deployment", "report.adversary"],
+  ["where is the enemy", "report.adversary"],
+  ["where are they", "report.adversary"],
+  ["opposing position", "report.adversary"],
+  ["adversary position", "report.adversary"],
+  ["condition", "report.overview"],
+  ["field condition", "report.overview"],
+  ["current condition", "report.overview"],
+  ["situation", "report.overview"],
+  ["strategic condition", "report.overview"],
+  ["state of the front", "report.overview"],
+  ["attrition", "report.losses"],
+  ["losses", "report.losses"],
+  ["casualties", "report.losses"],
+  ["strategy", "advice.strategy"],
+  ["strategic plan", "advice.strategy"],
+  ["strategic approach", "advice.strategy"],
+  ["course of action", "advice.strategy"],
+  ["way forward", "advice.strategy"],
+  ["how do we win", "advice.strategy"],
+  ["what is our strategy", "advice.strategy"],
+]);
+
+const resolve = (surface) =>
+  AVA_STATIC_LANGUAGE_CATALOG.find((entry) =>
+    entry.surfaces.some(
+      (candidate) =>
+        normalizeAvaLanguageSurface(candidate) ===
+        normalizeAvaLanguageSurface(surface),
+    ),
+  );
+
+test("contextual normalization is deterministic and punctuation bounded", () => {
+  assert.equal(normalizeAvaLanguageSurface("GAIN TERRITORY"), "gain territory");
+  assert.equal(normalizeAvaLanguageSurface("Gain-Territory"), "gain territory");
+  assert.equal(normalizeAvaLanguageSurface("gain, territory"), "gain territory");
+  assert.equal(normalizeAvaLanguageSurface("  advance  "), "advance");
+  assert.equal(normalizeAvaLanguageSurface("enemy-position"), "enemy position");
+  assert.equal(normalizeAvaLanguageSurface("KM"), "km");
+});
+
+test("static catalog owns every declared surface", () => {
+  assert.equal(
+    AVA_STATIC_LANGUAGE_CATALOG.flatMap((entry) => entry.surfaces).length,
+    expected.size,
+  );
+  for (const [surface, entryId] of expected)
+    assert.equal(resolve(surface)?.id, entryId, surface);
+  assert.equal(resolve("enemy position")?.id, "report.adversary");
+  assert.equal(resolve("position")?.id, "metric.position");
+  assert.equal(resolve("condition")?.id, "report.overview");
+  assert.equal(resolve("advance")?.id, "priority.advance");
+  assert.equal(resolve("front")?.id, "metric.front-movement");
+  assert.equal(resolve("strategy")?.id, "advice.strategy");
+});
+
+test("catalog collision validation accepts equivalent owners and rejects conflicts", () => {
+  const front = resolve("front");
+  assert.ok(front);
+  assert.doesNotThrow(() => validateLanguageEntries([front, { ...front, id: "front-copy" }]));
+  assert.throws(
+    () =>
+      validateLanguageEntries([
+        front,
+        {
+          ...front,
+          id: "front-conflict",
+          route: "REPORT",
+          entityId: undefined,
+          reportTopic: "overview",
+        },
+      ]),
+    /collision/i,
+  );
+});
+
+test("language digest is stable and changes with semantic content", () => {
+  const input = {
+    version: "ava-contextual-language/v1",
+    stateRevision: "state-1",
+    contentRevision: "content-1",
+    entries: AVA_STATIC_LANGUAGE_CATALOG,
+  };
+  const first = stableLanguageDigest(input);
+  const second = stableLanguageDigest({ ...input, entries: [...input.entries].reverse() });
+  assert.equal(first, second);
+  assert.notEqual(
+    first,
+    stableLanguageDigest({
+      ...input,
+      entries: input.entries.map((entry, index) =>
+        index === 0 ? { ...entry, label: `${entry.label} changed` } : entry,
+      ),
+    }),
+  );
+});
