+export const normalizeAvaLanguageSurface = (raw: string): string =>
+  raw
+    .normalize("NFKC")
+    .toLowerCase()
+    .replace(/[’‘]/g, "'")
+    .replace(/[^\p{L}\p{N}']+/gu, " ")
+    .trim()
+    .replace(/\s+/g, " ");
+
+const entryDestinationSignature = (entry: AvaLanguageEntry) =>
+  JSON.stringify({
+    route: entry.route,
+    entityId: entry.entityId ?? null,
+    reportTopic: entry.reportTopic ?? null,
+    facet: entry.facet ?? null,
+    priorityAxes: entry.priorityAxes ? [...entry.priorityAxes] : null,
+  });
+
+export const stableLanguageDigest = (input: {
+  version: AvaContextualLanguage["version"];
+  stateRevision: string;
+  contentRevision: string;
+  entries: readonly AvaLanguageEntry[];
+}): string => {
+  const entries = input.entries
+    .map((entry) => ({
+      ...entry,
+      surfaces: [...entry.surfaces].sort((left, right) => {
+        const normalized = normalizeAvaLanguageSurface(left).localeCompare(
+          normalizeAvaLanguageSurface(right),
+        );
+        return normalized || left.localeCompare(right);
+      }),
+      priorityAxes: entry.priorityAxes ? [...entry.priorityAxes] : undefined,
+      provenance: [...entry.provenance],
+      evidence: entry.evidence?.map((evidence) => ({ ...evidence })),
+    }))
+    .sort((left, right) => {
+      const leftSurface = normalizeAvaLanguageSurface(left.surfaces[0] ?? "");
+      const rightSurface = normalizeAvaLanguageSurface(right.surfaces[0] ?? "");
+      return (
+        left.id.localeCompare(right.id) ||
+        leftSurface.localeCompare(rightSurface) ||
+        left.route.localeCompare(right.route) ||
+        (left.entityId ?? "").localeCompare(right.entityId ?? "") ||
+        (left.reportTopic ?? "").localeCompare(right.reportTopic ?? "") ||
+        (left.priorityAxes ?? []).join(">").localeCompare(
+          (right.priorityAxes ?? []).join(">"),
+        )
+      );
+    });
+  return cognitiveDigest({
+    version: input.version,
+    stateRevision: input.stateRevision,
+    contentRevision: input.contentRevision,
+    entries,
+  });
+};
