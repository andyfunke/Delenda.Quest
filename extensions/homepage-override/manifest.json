{
  "manifest_version": 3,
  "name": "Custom Home Button",
  "version": "3.0.0",
  "description": "A toolbar home button with a user-settable target URL. Click it, type any URL, OK to save and go.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Home",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Home"
      },
      "description": "Open home button popup"
    }
  },
  "chrome_settings_overrides": {
    "homepage": "https://duckduckgo.com/"
  }
}
