{
  "manifest_version": 3,
  "name": "Custom Home Button",
  "version": "5.0.0",
  "description": "Makes the homepage user-settable. The home button opens whatever URL you save; click the toolbar icon to change it.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://home-button.internal/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Set home page",
    "default_popup": "popup.html"
  },
  "chrome_settings_overrides": {
    "homepage": "https://home-button.internal/"
  }
}
