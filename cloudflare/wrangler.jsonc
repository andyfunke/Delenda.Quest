{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "delenda-quest-shadow",
  "main": "../dist/server/index.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "no_bundle": true,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delenda-quest-shadow",
      "migrations_dir": "../drizzle"
    }
  ],
  "vars": {
    "DELENDA_AUTH_PROVIDER": "cloudflare-access",
    "DELENDA_MAINTENANCE_MODE": "off"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_TEAM_DOMAIN",
      "CF_ACCESS_AUD",
      "DELENDA_ADMIN_EMAILS",
      "DELENDA_REPLICATION_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
