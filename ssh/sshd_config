Port __PORT__
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::
HostKey /run/delenda/ssh_host_ed25519_key
PidFile /run/delenda/sshd.pid
AuthorizedKeysCommand /app/ssh/authorized-keys-command %u %t %k %f
AuthorizedKeysCommandUser nobody
AuthenticationMethods publickey
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM no
PermitRootLogin no
AllowUsers play
StrictModes no
PermitEmptyPasswords no
PermitTTY yes
PermitUserEnvironment no
PermitUserRC no
DisableForwarding yes
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
MaxAuthTries 3
MaxSessions 1
MaxStartups 10:30:60
LoginGraceTime 30
ClientAliveInterval 60
ClientAliveCountMax 3
TCPKeepAlive yes
PrintMotd no
PrintLastLog no
Banner none
Subsystem sftp /bin/false
LogLevel VERBOSE
