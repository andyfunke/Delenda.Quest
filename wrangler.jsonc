{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "delenda-quest",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "delenda.quest",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delenda-quest",
      "database_id": "a2d8a23e-f038-48a6-801a-46a30d58f1ba",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "DELENDA_AUTH_PROVIDER": "self-hosted",
    "DELENDA_MAINTENANCE_MODE": "off"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
